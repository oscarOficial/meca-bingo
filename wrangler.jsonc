{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meca-bingo",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true },
  // Anonymous usage statistics (created automatically on the first deploy)
  "d1_databases": [{ "binding": "DB", "database_name": "meca-bingo-stats" }]
}
